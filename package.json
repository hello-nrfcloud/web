{
  "name": "@hello.nrfcloud.com/web",
  "version": "0.0.0-development",
  "description": "Retrieve real-time data from your long-range Nordic Semiconductor Development Kit within seconds",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-nrfcloud/web.git"
  },
  "bugs": {
    "url": "https://github.com/hello-nrfcloud/web/issues"
  },
  "homepage": "https://hello.nrfcloud.com",
  "keywords": [
    "nordicsemiconductor",
    "cellular-iot",
    "hello-nrfcloud"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "scripts": {
    "start": "vike dev",
    "build": "node --max_old_space_size=8192 ./node_modules/vite/bin/vite.js build --emptyOutDir && cp -v ./manifest.json ./build/client/",
    "prepare": "husky",
    "test": "find ./ -type f -name *.spec.ts -not -path './e2e-tests/*' -not -path './node_modules/*' | xargs npx tsx --test --test-reporter spec",
    "test:e2e": "npx playwright test e2e-tests/",
    "start:e2e": "vite -c e2e-tests/vite.config.e2e.ts",
    "postinstall": "cp -r node_modules/svg-country-flags/svg/ static/flags"
  },
  "dependencies": {
    "@hello.nrfcloud.com/proto": "15.4.41",
    "@hello.nrfcloud.com/proto-map": "16.4.5",
    "@sentry/browser": "9.42.0",
    "@sinclair/typebox": "0.34.38",
    "classnames": "2.5.1",
    "code-128-encoder": "3.1.1",
    "compare-versions": "6.1.1",
    "date-fns": "4.1.0",
    "e118-iin-list": "4.5.0",
    "html5-qrcode": "2.3.8",
    "lodash-es": "4.17.21",
    "lucide-preact": "0.528.0",
    "maplibre-gl": "5.6.1",
    "nanoid": "5.1.5",
    "preact": "10.26.9",
    "qrcode": "1.5.4",
    "semver": "7.7.2",
    "svg-country-flags": "1.2.10",
    "yaml": "2.8.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.855.0",
    "@aws-sdk/client-cloudfront": "3.855.0",
    "@aws-sdk/client-iam": "3.855.0",
    "@babel/plugin-syntax-import-assertions": "7.27.1",
    "@bifravst/cloudformation-helpers": "9.1.1",
    "@bifravst/eslint-config-typescript": "6.4.2",
    "@bifravst/from-env": "3.0.2",
    "@bifravst/prettier-config": "1.1.12",
    "@commitlint/config-conventional": "19.8.1",
    "@playwright/test": "1.54.1",
    "@preact/preset-vite": "2.10.2",
    "@swc/core": "1.13.2",
    "@types/lodash-es": "4.17.12",
    "@types/node": "22.16.5",
    "@types/qrcode": "1.5.5",
    "@types/semver": "7.7.0",
    "@types/websocket": "1.0.10",
    "aws-cdk": "2.1022.0",
    "aws-cdk-lib": "2.207.0",
    "bootstrap": "5.3.7",
    "cdk": "2.1022.0",
    "chalk": "5.4.1",
    "commitlint": "19.8.1",
    "glob": "11.0.3",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "nock": "14.0.6",
    "playwright": "1.54.1",
    "preact-render-to-string": "6.5.13",
    "rehype-format": "5.0.1",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-extract-frontmatter": "3.2.0",
    "remark-frontmatter": "5.0.0",
    "remark-rehype": "11.1.2",
    "tsmatchers": "5.0.3",
    "tsx": "4.20.3",
    "vike": "0.4.236",
    "websocket": "1.0.35"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml,html,css}": [
      "prettier --write"
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  }
}
