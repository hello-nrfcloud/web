{
  "name": "@hello.nrfcloud.com/web",
  "version": "0.0.0-development",
  "description": "Retrieve real-time data from your long-range Nordic Semiconductor Development Kit within seconds",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*",
    "#context/*": "./src/context/*",
    "#flows/*": "./src/flows/*",
    "#chart/*": "./src/chart/*",
    "#utils/*": "./src/utils/*",
    "#page/*": "./src/page/*",
    "#proto/*": "./src/proto/*",
    "#map/*": "./src/map/*",
    "#model/*": "./src/model/*",
    "#content/*": "./content/*",
    "#api/*": "./src/api/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-nrfcloud/web.git"
  },
  "bugs": {
    "url": "https://github.com/hello-nrfcloud/web/issues"
  },
  "homepage": "https://hello.nrfcloud.com",
  "keywords": [
    "nordicsemiconductor",
    "cellular-iot",
    "hello-nrfcloud"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "scripts": {
    "start": "vike dev",
    "build": "node --max_old_space_size=8192 ./node_modules/vite/bin/vite.js build && cp -v ./manifest.json ./build/client/",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "test": "node --experimental-transform-types --test --test-reporter spec \"!(e2e-tests|node_modules)/**/*.spec.ts\"",
    "test:e2e": "npx playwright test e2e-tests/",
    "start:e2e": "vite -c e2e-tests/vite.config.e2e.ts",
    "postinstall": "cp -r node_modules/svg-country-flags/svg/ static/flags"
  },
  "dependencies": {
    "@hello.nrfcloud.com/proto": "16.0.0",
    "@hello.nrfcloud.com/proto-map": "17.1.1",
    "@sentry/browser": "10.72.0",
    "@sinclair/typebox": "0.34.52",
    "classnames": "2.5.1",
    "code-128-encoder": "3.1.1",
    "compare-versions": "6.1.1",
    "date-fns": "4.4.0",
    "e118-iin-list": "5.0.0",
    "html5-qrcode": "2.3.8",
    "lodash-es": "4.18.1",
    "lucide-preact": "1.37.0",
    "maplibre-gl": "6.6.0",
    "nanoid": "6.0.1",
    "preact": "10.29.8",
    "qrcode": "1.5.4",
    "semver": "7.8.5",
    "svg-country-flags": "1.2.10",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1121.0",
    "@aws-sdk/client-cloudfront": "3.1121.0",
    "@aws-sdk/client-iam": "3.1121.0",
    "@babel/plugin-syntax-import-assertions": "7.29.7",
    "@bifravst/cloudformation-helpers": "10.0.1",
    "@bifravst/eslint-config-typescript": "8.0.2",
    "@bifravst/from-env": "4.0.0",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@swc/core": "1.16.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.4.0",
    "@types/qrcode": "1.5.6",
    "@types/semver": "7.8.0",
    "@types/websocket": "1.0.10",
    "@typescript/native": "npm:typescript@7.0.2",
    "aws-cdk": "2.1139.0",
    "aws-cdk-lib": "2.266.0",
    "bootstrap": "5.3.8",
    "cdk": "2.1139.0",
    "chalk": "6.0.0",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.2",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "nock": "14.0.17",
    "playwright": "1.62.1",
    "preact-render-to-string": "6.7.0",
    "rehype-format": "5.0.1",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-extract-frontmatter": "3.2.0",
    "remark-frontmatter": "5.0.0",
    "remark-rehype": "11.1.2",
    "tsmatchers": "6.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vike": "0.4.262",
    "websocket": "1.0.35"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml,html,css}": [
      "prettier --write"
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  }
}
